if (mSetVoltageDerivativeToZero)
{
    {% for deriv in y_derivative_equations %}{%- if deriv.is_voltage %}{{ deriv.lhs }} = 0.0;{%- endif %}{%- endfor %}
}
else
{
    {% for deriv in y_derivative_equations %}
        {%- if not deriv.in_eqs_excl_voltage %}
            {%- if deriv.is_data_clamp_current is defined and deriv.is_data_clamp_current %}
                double {{ deriv.lhs }} = 0.0;
                if (mDataClampIsOn)
                {
                    {{ deriv.lhs }} = {{ deriv.rhs }};
                }
            {%- else %}
                {% if not deriv.is_voltage %}const double {% endif %}{{ deriv.lhs }} = {{ deriv.rhs }};
            {%- endif %}
        {%- endif %}
    {%- endfor %}
}